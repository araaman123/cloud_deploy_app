# DevOps Automation SaaS - Environment Configuration

# API Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=True
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloud_deploy
SQLALCHEMY_ECHO=False

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
ECR_REGISTRY=123456789.dkr.ecr.us-east-1.amazonaws.com

# Kubernetes Configuration
KUBERNETES_NAMESPACE=default
KUBECONFIG_PATH=~/.kube/config

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5173"]

# Monitoring
PROMETHEUS_ENABLED=True
ELK_ENABLED=True

# Terraform Configuration
TERRAFORM_VERSION=1.5.0
TERRAFORM_STATE_BACKEND=local

# Logging
LOG_LEVEL=INFO
